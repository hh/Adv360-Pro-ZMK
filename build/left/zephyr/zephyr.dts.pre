&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <((((((0) * 32U) + (20)) & 0x7FU) << 0U) | ((5U & 0xFFFFU) << 16U))>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <((((((0) * 32U) + (20)) & 0x7FU) << 0U) | ((5U & 0xFFFFU) << 16U))>;
            low-power-enable;
        };
    };
    pwm0_default: pwm0_default {
        group1 {
            psels = <((((((0) * 32U) + (17)) & 0x7FU) << 0U) | ((22U & 0xFFFFU) << 16U))>;
        };
    };
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <((((((0) * 32U) + (17)) & 0x7FU) << 0U) | ((22U & 0xFFFFU) << 16U))>;
            low-power-enable;
        };
    };
};
