/{
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&gpio1 11 ((0 << 0) | (1 << 5))>
            , <&gpio1 15 ((0 << 0) | (1 << 5))>
            , <&gpio0 3 ((0 << 0) | (1 << 5))>
            , <&gpio1 14 ((0 << 0) | (1 << 5))>
            , <&gpio1 12 ((0 << 0) | (1 << 5))>
            ;

        col-gpios
            = <&gpio0 25 (0 << 0)>
            , <&gpio0 11 (0 << 0)>
            , <&gpio0 2 (0 << 0)>
            , <&gpio0 28 (0 << 0)>
            , <&gpio0 29 (0 << 0)>
            , <&gpio0 30 (0 << 0)>
            , <&gpio0 31 (0 << 0)>
            , <&gpio1 9 (0 << 0)>
            , <&gpio0 12 (0 << 0)>
            , <&gpio0 7 (0 << 0)>
            ;
    };
};
